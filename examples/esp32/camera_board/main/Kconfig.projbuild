menu "dc-device camera board"

config DC_DEVICE_WIFI_SSID
    string "Wi-Fi SSID (development only; ignored in a release build)"
    default ""

config DC_DEVICE_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""

config DC_DEVICE_RELEASE
    bool "Release build"
    default n
    help
        Leaves out the debug.* capabilities and ignores the Wi-Fi name and
        password above. The network then comes only from USB setup.

config DC_DEVICE_HTTP_PORT
    int "HTTP port"
    default 8787
    range 1 65535

config DC_DEVICE_CAMERA_KNOWN_MAP
    bool "Start from the known camera wiring (SDA 4, SCL 5)"
    default y
    help
        Turn off to make the firmware find the camera by searching only,
        which is how the scan is tested.

endmenu
